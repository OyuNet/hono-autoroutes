{
  "name": "hono-autoroutes",
  "version": "0.5.0",
  "description": "Zero-magic file-based routing loader for Hono (mount routes/**/route.ts).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "npm run lint && npm run typecheck:public && npm test && npm run build && npm run smoke",
    "prepublishOnly": "npm run clean && npm run check",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck:public": "tsc -p tsconfig.type-tests.json",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "keywords": [
    "hono",
    "router",
    "routes",
    "file-based",
    "autoroutes"
  ],
  "author": "Arda Yiğit Tok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OyuNet/hono-autoroutes.git"
  },
  "bugs": {
    "url": "https://github.com/OyuNet/hono-autoroutes/issues"
  },
  "homepage": "https://github.com/OyuNet/hono-autoroutes#readme",
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "hono": "^4.13.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
